{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@familiai/core": ["./../../packages/core/src/index.ts"],
      "@stream/*": ["./../stream-copilot/src/*"]
    }
  },
  "include": ["src/main", "src/preload", "src/shared", "test"]
}
