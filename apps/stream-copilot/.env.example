# Copy this file to .env and fill it in. Never share or commit .env.

# OBS: Tools > WebSocket Server Settings > enable, then copy the password here.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Twitch: create an app at dev.twitch.tv/console, then make a user token with these scopes:
#   chat:read chat:edit moderator:manage:banned_users moderator:manage:chat_messages
TWITCH_CLIENT_ID=
TWITCH_TOKEN=
TWITCH_CHANNEL=
