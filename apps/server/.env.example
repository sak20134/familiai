# Copy to ".env". Leave the key empty to use the free demo brain.
ANTHROPIC_API_KEY=
# FAMILYAI_MODEL=claude-sonnet-5-5
# PORT=8787

# Phone calls (optional): your Twilio account and a Twilio phone number
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# Google Calendar (optional): from Google Cloud Console > Credentials > OAuth client (Web)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/oauth/google/callback
